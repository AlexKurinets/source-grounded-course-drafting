# Host ports for the Compose stack
POSTGRES_PORT=5452
API_PORT=8090
REVIEW_PORT=8091

# Model routes. "offline" runs everything with the deterministic drafter and needs no keys.
COURSEDRAFT_HOSTED_ADAPTER=offline   # offline | anthropic | openai
COURSEDRAFT_LOCAL_ADAPTER=offline    # offline | ollama (the local route never accepts a hosted service)
COURSEDRAFT_HOSTED_MODEL=claude-opus-5-5
COURSEDRAFT_LOCAL_MODEL=qwen3:14b
ANTHROPIC_API_KEY=
